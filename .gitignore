data/audio
data/_audio_assembled
data/model_outputs/responses
data/model_outputs/transcripts
data/model_outputs/_llm_cache
data/model_outputs/wer/wer_per_clip.csv
data/model_outputs/secondary_speech_metrics.csv
**/_pre_rerun_reference/

