# --- NEVER COMMIT: participant re-identification linkage -------------------
private/
**/id_map*.csv
*prolific*.csv
*qualtrics*.csv

# --- NEVER COMMIT: credentials ---------------------------------------------
.env
.env.*
!.env.example
.openai_env
.claude/
*.pem
*.key
secrets*.json
service-account*.json
application_default_credentials.json

# --- Bulk data: fetched from Hugging Face, never tracked -------------------
