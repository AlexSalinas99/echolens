# EchoLens — copy to .env and fill in. .env is gitignored; never commit it.
# Only needed to re-run model inference (notebooks 05-06, 10 and
# scripts/run_inference.py). The analysis-only path needs none of these.

# --- OpenAI -----------------------------------------------------------------
# gpt-audio-1.5 responses, whisper-1 ASR, gpt-4o-mini extraction fallback.
OPENAI_API_KEY=

# --- Gemini via Vertex AI (preferred) ---------------------------------------
# The released Gemini responses were produced this way. Auth is Application
# Default Credentials: run `gcloud auth application-default login` once.
GEMINI_VERTEX_PROJECT=your-gcp-project
GEMINI_VERTEX_LOCATION=global

# --- Gemini via AI Studio API key (fallback) --------------------------------
# Used only when the Vertex variables above are unset.
# GOOGLE_API_KEY=
# GEMINI_API_KEY=

# --- Kimi-Audio -------------------------------------------------------------
# Path to a clone of https://github.com/MoonshotAI/Kimi-Audio
KIMI_AUDIO_REPO=

# --- Local GPU selection (Qwen2.5-Omni, Kimi-Audio) -------------------------
CUDA_VISIBLE_DEVICES=0

# --- Hugging Face -----------------------------------------------------------
# Needed to download the dataset, which is gated. Get one at
# https://huggingface.co/settings/tokens (read scope is enough).
# HF_TOKEN=
